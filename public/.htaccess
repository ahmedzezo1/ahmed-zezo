# Enable URL rewriting for front-controller pattern
<IfModule mod_rewrite.c>
  Options -MultiViews
  RewriteEngine On

  # If the request is for an existing file or directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise, send to index.php (front controller)
  RewriteRule ^ index.php [L]
</IfModule>

# Fallback if mod_rewrite is unavailable: deny PHP file listing
<IfModule !mod_rewrite.c>
  <FilesMatch "\.php$">
    Require all denied
  </FilesMatch>
</IfModule>
